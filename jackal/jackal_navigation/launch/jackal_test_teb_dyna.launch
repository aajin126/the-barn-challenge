<!-- -->
<launch>

  <master auto="start"/>
  
  <!-- Map Server-->
  <arg name="map_file" default="$(find jackal_gazebo)/worlds/free_map.yaml" />
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen">
  </node>

  <!--node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="-2 3 0 1.5708 0 0 map odom 10">
  </node-->

  <node pkg="gazebo_fake_localization" type="gazebo_fake_localization" name="gazebo_fake_localization" output="screen">
    <param name="base_frame_id" value="base_link"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="gazebo_frame_id" value="map"/>
    <param name="model_name" value="jackal"/>
    <param name="freq" value="30"/> 
  </node>
  
  
  <!-- RViz-->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find jackal_viz)/rviz/navigation.rviz"/>

  <!--env name="ROSCONSOLE_CONFIG_FILE" value="$(find teb_planner_hj)/config/custom_rosconsole.conf"/-->  
  
  <arg name="cmd_vel_topic" default="/jackal_velocity_controller/cmd_vel" />
  <arg name="odom_topic" default="/odometry/filtered" />
  <!--arg name="odom_topic" default="/jackal_velocity_controller/odom" /-->
  <arg name="move_forward_only" default="false"/>   
  <arg name="use_sim_time" value="true"/>

  <arg name="msg" default="Starting TEB local planner." />
  
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" args="pub /msg std_msgs/String '$(arg msg)'" output="screen">
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <rosparam file="$(find jackal_navigation)/params/param_teb/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find jackal_navigation)/params/param_teb/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    
    <rosparam file="$(find jackal_navigation)/params/param_teb/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find jackal_navigation)/params/param_teb/global_costmap_params.yaml" command="load" />
    
    <rosparam file="$(find jackal_navigation)/params/param_teb/move_base_params.yaml" command="load" />
    <rosparam file="$(find jackal_navigation)/params/param_teb/teb_local_planner_params.yaml" command="load" />

    
    <remap from="odom" to="$(arg odom_topic)"/>
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <!--remap from="odom" to="$(arg odom_topic)"/-->
        
    <param name="TebLocalPlannerROS/map_frame" value="odom"/>

    <param name="base_global_planner" type="string" value="navfn/NavfnROS" />
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>


  </node>

</launch>
