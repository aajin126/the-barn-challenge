<!-- 

-->
<launch>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find former_helper)/launch/rviz_config/barn_rviz.rviz"/>
  
  
  <arg name="cmd_vel_topic" default="/former_base_controller/cmd_vel" />
  <arg name="odom_topic" default="/former_base_controller/odom" />
  <arg name="move_forward_only" default="false"/>

  <arg name="msg" default="Starting TEB local planner." />
  
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" args="pub /msg std_msgs/String '$(arg msg)'" output="screen">
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS" />
    <rosparam file="$(find former_helper)/configs/params/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find former_helper)/configs/params/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    
    <rosparam file="$(find former_helper)/configs/params/odom_nav_params/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find former_helper)/configs/params/odom_nav_params/local_costmap_params.yaml" command="load" />
    
    <rosparam file="$(find former_helper)/configs/params/param_ours/teb_local_planner_params.yaml" command="load" />
    <rosparam file="$(find former_helper)/configs/params/move_base_params.yaml" command="load" />
    
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    
    <param name="TebLocalPlannerROS/map_frame" value="odom"/>

    <param name="base_global_planner" type="string" value="navfn/NavfnROS" />
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>
    <param name="NavfnROS/plan_cost_mode" value="meanmax"/>
  </node>

</launch>
