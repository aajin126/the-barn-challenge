import os
import re

# 변경할 pose 값
new_pose = "<pose frame=''>-2.5456 5.7086 11.325 0 1.5699 3.1402</pose>"

# world 파일들이 있는 디렉터리
world_dir = "./world_file"

# pose 태그 정규식 패턴
pattern = re.compile(r"<pose frame=''>.*?</pose>")

for filename in os.listdir(world_dir):
    if filename.endswith(".world"):
        file_path = os.path.join(world_dir, filename)
        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()

        # camera 블록 안의 pose만 변경
        def replace_pose(match):
            return new_pose

        # <camera name='user_camera'> 블록 안에서만 교체
        content = re.sub(
            r"(<camera name='user_camera'>.*?<pose frame=''>)(.*?)(</pose>)",
            f"\\1-2.5456 5.7086 11.325 0 1.57 3.14\\3",
            content,
            flags=re.DOTALL
        )

        with open(file_path, "w", encoding="utf-8") as f:
            f.write(content)

        print(f"Updated {filename}")

